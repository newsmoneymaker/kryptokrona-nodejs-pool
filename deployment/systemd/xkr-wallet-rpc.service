[Unit]
Description=Kryptokrona pool wallet (wallet-service, 127.0.0.1:41899, no password: local use only)
After=xkr-node.service
Requires=xkr-node.service

[Service]
Type=simple
User=xkrpool
ExecStart=/opt/kryptokrona/bin/kryptokrona-service --wallet-file /opt/kryptokrona/wallet/pool --password-file /opt/kryptokrona/wallet/password --rpc-bind-ip 127.0.0.1 --rpc-bind-port 41899 --disable-rpc-login --daemon-address 127.0.0.1:11898 --trusted-daemon --log-file /opt/kryptokrona/wallet/wallet-service.log --max-log-file-size 0
Restart=on-failure
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
