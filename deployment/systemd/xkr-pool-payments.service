[Unit]
Description=Kryptokrona pool: payment processor (sendmany from the pool wallet; emergency brake: deployment/pause-payments.sh)
After=xkr-pool-redis.service xkr-node.service xkr-wallet-rpc.service
Requires=xkr-pool-redis.service
[Service]
Type=simple
User=xkrpool
WorkingDirectory=/opt/xkr-nodejs-pool
ExecStart=/usr/bin/node /opt/xkr-nodejs-pool/init.js -module=payments
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
