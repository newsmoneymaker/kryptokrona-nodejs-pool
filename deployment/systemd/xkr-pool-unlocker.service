[Unit]
Description=Kryptokrona pool: block unlocker (credits the miners after the coinbase maturity)
After=xkr-pool-redis.service xkr-node.service xkr-wallet-rpc.service
Requires=xkr-pool-redis.service
[Service]
Type=simple
User=xkrpool
WorkingDirectory=/opt/xkr-nodejs-pool
ExecStart=/usr/bin/node /opt/xkr-nodejs-pool/init.js -module=unlocker
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
